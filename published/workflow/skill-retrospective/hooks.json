{
  "skill-retrospective-log-skill-use": {
    "PostToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          { "type": "command", "command": "node ./hooks/log-skill-use.mjs --antigravity", "timeout": 10 }
        ]
      }
    ]
  },
  "skill-retrospective-hint": {
    "Stop": [
      { "type": "command", "command": "node ./hooks/retrospective-hint.mjs --antigravity", "timeout": 10 }
    ]
  }
}
